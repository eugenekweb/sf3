# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# URL веб-сервера (для бота, внутри Docker сети)
BACKEND_URL=http://web:5000

# Туннель Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=<токен_туннеля>
CLOUDFLARE_TUNNEL_IMAGE=cloudflare/cloudflared:latest

# Окружение Flask
FLASK_ENV=production

# отключить веб-апп, использовать только прямую загрузку
WEBAPP_DISABLED=false
# использовать только веб-апп
WEBAPP_ONLY=false

# Режим отладки
DEBUG=False
